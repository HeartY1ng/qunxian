#!/usr/bin/env python3
"""
qunxian —— 仓库根目录的命令入口（给不用 agent、直接在终端里用的人）

真正的程序在 skills/qunxian/qunxian.py。这个文件只是转一下手，
这样在仓库根目录就能直接运行 ./qunxian run "话题"；把仓库加进 PATH 后，任何地方都能用 qunxian。
用 resolve() 找真实位置，所以通过软链接调用也没问题。
"""
import runpy
import sys
from pathlib import Path

target = Path(__file__).resolve().parent / "skills" / "qunxian" / "qunxian.py"
sys.argv[0] = str(target)
runpy.run_path(str(target), run_name="__main__")
